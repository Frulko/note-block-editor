      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./idb": {
      "types": "./src/idb.ts",
      "default": "./src/idb.ts"
    },
    "./vault": {
      "types": "./src/vault.ts",
      "default": "./src/vault.ts"
    },
    "./notion": {
      "types": "./src/notion.ts",
      "default": "./src/notion.ts"
    },
    "./enhanced": {
      "types": "./src/enhanced.ts",
      "default": "./src/enhanced.ts"
    },
    "./collection": {
      "types": "./src/collection.ts",
      "default": "./src/collection.ts"
    },
    "./database": {
      "types": "./src/database.ts",
