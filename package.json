{
  "name": "notion-block-editor",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter demo-vanilla dev",
    "build": "pnpm --filter demo-vanilla build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc --options typedoc.json",
    "site": "pnpm docs:api && pnpm --filter site dev",
    "site:build": "pnpm docs:api && pnpm --filter site build",
    "site:deploy": "gh workflow run site.yml",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "emojibase-data": "^17.0.0",
    "happy-dom": "^20.11.1",
    "lucide-static": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.8",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.41"
  },
  "author": "Guillaume Dumoulin"
}
