---
import Base from '../layouts/Base.astro';
import '@nbe/dom/style.css';
import PlaygroundDemo from '../components/demos/PlaygroundDemo.tsx';
---
<Base title="Démo — Carnet">
  <div class="shell" style="padding-top:2.5rem;padding-bottom:5rem;">
    <div class="prose">
      <h1>Démo</h1>
      <p>
        Un éditeur complet. Tapez <code>/</code> pour le menu de blocs&nbsp;;
        survolez un bloc pour voir ses deux marges d'action — le <code>+</code>
        et la poignée ⋮⋮ à gauche, le commentaire à droite — et glissez la
        poignée pour réordonner. Déposez un fichier <code>.md</code> sur
        l'éditeur pour le charger, et inspectez le document en JSON ou en
        markdown via la barre de debug.
      </p>
      <p>
        <strong>Réglages</strong> ouvre les vraies options de montage&nbsp;:
        géométrie, lecture seule, topologie de l'élément éditable, colonnes
        expérimentales, et chaque fonctionnalité activable une par une — ce que
        vous décochez n'est pas seulement caché, il n'est pas attaché.
      </p>
    </div>
    <div class="demo-frame" style="max-height:none;">
      <PlaygroundDemo client:load />
    </div>
  </div>
</Base>
