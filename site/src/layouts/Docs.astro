---
import Base from './Base.astro';
interface Props { title: string; description?: string; wide?: boolean }
const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { title: 'Découvrir', items: [
    { href: `${base}/docs/why/`, label: 'Pourquoi cet éditeur' },
    { href: `${base}/docs/getting-started/`, label: 'Démarrer' },
    { href: `${base}/docs/examples/`, label: 'Exemples' },
    { href: `${base}/docs/markdown/`, label: 'Markdown' },
    { href: `${base}/docs/hosts/`, label: 'Où ça tourne' },
  ]},
  { title: 'Concepts', items: [
    { href: `${base}/docs/concepts/blocks/`, label: 'Blocs et schéma' },
    { href: `${base}/docs/concepts/operations/`, label: 'Opérations' },
    { href: `${base}/docs/concepts/projections/`, label: 'Projections' },
  ]},
  { title: 'Étendre', items: [
    { href: `${base}/docs/extending/plugins/`, label: 'Plugins' },
  ]},
  { title: 'Référence', items: [
    { href: `${base}/docs/api/`, label: 'Vue d\'ensemble' },
    { href: `${base}/docs/api/editor/`, label: 'Éditeur : méthodes, événements' },
    { href: `${base}/docs/api/configuration/`, label: 'Configuration' },
    { href: `${base}/docs/api/theming/`, label: 'Thème et CSS' },
    { href: `${base}/docs/api/plugins/`, label: 'API des plugins' },
  ]},
];
---
<Base title={`${title} — nbe`} description={description}>
  <div class="shell docs">
    <aside class="docs-nav">
      {sections.map((s) => (
        <>
          <h4>{s.title}</h4>
          <ul>{s.items.map((i) => (
            <li><a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a></li>
          ))}</ul>
        </>
      ))}
    </aside>
    <article class={wide ? "prose prose-wide" : "prose"}>
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</Base>
